<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>3b7f1e9a-4c2d-41a5-82b9-e1f8d3c5a7b2</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>OBPLOT Developer</ProviderName>
  <DefaultLocale>ja-JP</DefaultLocale>
  <DisplayName DefaultValue="OBPLOT 1.0"/>
  <Description DefaultValue="PXRF Data Analyzer"/>
  
  <!-- 画像URLを自作の image/ フォルダへ変更 -->
  <IconUrl DefaultValue="https://rei-watanabe-chiba.github.io/OBPLOT/image/icon32.png"/>
  <HighResolutionIconUrl DefaultValue="https://rei-watanabe-chiba.github.io/OBPLOT/image/icon64.png"/>
  <SupportUrl DefaultValue="https://github.com/rei-watanabe-chiba/OBPLOT"/>

  <AppDomains>
    <AppDomain>https://rei-watanabe-chiba.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://rei-watanabe-chiba.github.io/OBPLOT/App.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="ObplotTab">
              <Group id="ObplotGroup">
                <Label resid="GroupLabel"/>
                <Icon>
                  <bt:Image size="16" resid="Icon16"/>
                  <bt:Image size="32" resid="Icon32"/>
                  <bt:Image size="80" resid="Icon80"/>
                </Icon>
        <Control xsi:type="Button" id="BtnTab1">
                  <Label resid="Btn1Label"/>
                  <Supertip><Title resid="Btn1Title"/><Description resid="Btn1Desc"/></Supertip>
                  <Icon><bt:Image size="16" resid="Icon16"/><bt:Image size="32" resid="Icon32"/><bt:Image size="80" resid="Icon80"/></Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>PaneT1</TaskpaneId>
                    <SourceLocation resid="UrlTab1"/>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="BtnTab2">
                  <Label resid="Btn2Label"/>
                  <Supertip><Title resid="Btn2Title"/><Description resid="Btn2Desc"/></Supertip>
                  <Icon><bt:Image size="16" resid="Icon16"/><bt:Image size="32" resid="Icon32"/><bt:Image size="80" resid="Icon80"/></Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>PaneT2</TaskpaneId>
                    <SourceLocation resid="UrlTab2"/>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="BtnTab3">
                  <Label resid="Btn3Label"/>
                  <Supertip><Title resid="Btn3Title"/><Description resid="Btn3Desc"/></Supertip>
                  <Icon><bt:Image size="16" resid="Icon16"/><bt:Image size="32" resid="Icon32"/><bt:Image size="80" resid="Icon80"/></Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>PaneT3</TaskpaneId>
                    <SourceLocation resid="UrlTab3"/>
                  </Action>
                </Control>
              </Group>
              <Label resid="TabLabel"/>
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <!-- リボン用アイコン群を image/ フォルダへ変更 -->
        <bt:Image id="Icon16" DefaultValue="https://rei-watanabe-chiba.github.io/OBPLOT/image/icon16.png"/>
        <bt:Image id="Icon32" DefaultValue="https://rei-watanabe-chiba.github.io/OBPLOT/image/icon32.png"/>
        <bt:Image id="Icon80" DefaultValue="https://rei-watanabe-chiba.github.io/OBPLOT/image/icon80.png"/>
      </bt:Images>
      <bt:Urls>
        <!-- ★重要：Web版Excelの強烈なキャッシュを破棄するため「&amp;v=3」を付与 -->
        <bt:Url id="UrlTab1" DefaultValue="https://rei-watanabe-chiba.github.io/OBPLOT/Tracer.html?mode=tab1&amp;v=3"/>
        <bt:Url id="UrlTab2" DefaultValue="https://rei-watanabe-chiba.github.io/OBPLOT/Tracer.html?mode=tab2&amp;v=3"/>
        <bt:Url id="UrlTab3" DefaultValue="https://rei-watanabe-chiba.github.io/OBPLOT/Dash.html?mode=tab3&amp;v=3"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="OBPLOT"/>
        <bt:String id="TabLabel" DefaultValue="OBPLOT"/>
        <bt:String id="Btn1Label" DefaultValue="tracer5i抽出"/>
        <bt:String id="Btn1Title" DefaultValue="データ抽出ツールを起動"/>
        <bt:String id="Btn2Label" DefaultValue="検量線・標準化"/>
        <bt:String id="Btn2Title" DefaultValue="簡易プレビュー＆データ標準化ツールを起動"/>
        <bt:String id="Btn3Label" DefaultValue="ダッシュボード"/>
        <bt:String id="Btn3Title" DefaultValue="グラフダッシュボードを起動"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Btn1Desc" DefaultValue="tracer5iデータのモード対応抽出を行います"/>
        <bt:String id="Btn2Desc" DefaultValue="tracer5iデータをプレビューして標準データに変換します"/>
        <bt:String id="Btn3Desc" DefaultValue="グラフ作成・出力用ダッシュボードを作成します"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
